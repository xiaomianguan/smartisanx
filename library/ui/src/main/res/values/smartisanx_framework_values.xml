<?xml version="1.0" encoding="utf-8"?>
<!-- 锤子 framework 的值资源（逐项按需导入）。 -->
<resources>
    <color name="chips_error_color">#cc3e39</color>
    <color name="chips_error_pressed_color">#ffffff</color>
    <color name="chips_history_color">#666666</color>
    <color name="chips_hot_color">#cc3e39</color>
    <color name="chips_light_color">#a9000000</color>
    <color name="chips_normal_color">#3965cc</color>
    <color name="chips_pressed_color">#ffffff</color>
    <color name="chips_recommended_color">#996b3d</color>
    <color name="chips_shadow_color">#26000000</color>
    <color name="chips_unidentified_color">#3965cc</color>

    <!--
      日期 / 时间选择器（framework `res/values/colors.xml`、`res/values/dimens.xml`）。
      普通版（SmartisanDatePicker / SmartisanTimePicker）与 Ex 版各一套文字色；
      日历「一天」视图的选中色复用 smartisanx_assets_values.xml 里的
      calander_date_pick_select_day_color。
    -->
    <color name="date_pick_normal_day_color">#ffb3b3b5</color>
    <color name="date_pick_select_day_color">#ff55585c</color>
    <color name="date_pick_ex_normal_day_color">#4c000000</color>
    <color name="date_pick_ex_select_day_color">#9a000000</color>
    <color name="date_time_picker_divider_bg">#0c000000</color>
    <dimen name="date_time_picker_height">220.0dp</dimen>
    <dimen name="time_picker_height">128.0dp</dimen>
    <dimen name="time_picker_width">360.0dp</dimen>
    <dimen name="smartisan_datepicker_divider_width">2.0px</dimen>


    <!--
      空态（framework `smartisanos.widget.SmartisanBlankView`、
      `res/layout/blank_view.xml`、`res/values/dimens.xml`）。
    -->
    <dimen name="blank_view_vertical_margin">40.0dp</dimen>
    <dimen name="blankview_actionbtn_margintop">84.0dp</dimen>
    <dimen name="small_blank_image_size">60.0dp</dimen>

    <!--
      跑马灯标题（framework `smartisanos.widget.SmartisanMarqueeView`、
      `res/layout/marquee_title_center_layout.xml`、`res/values/styles.xml` 的
      `TitleTextStyle` / `SubTitleTextStyle`）。
    -->
    <color name="smartisan_button_normal_text_color">#666666</color>
    <color name="sub_title_text_color">#4c000000</color>
    <dimen name="title_bar_title_text_size">20.0sp</dimen>
    <dimen name="item_sub_title_size">10.0sp</dimen>
    <dimen name="marquee_title_margin_top">8.8dp</dimen>
    <dimen name="marquee_subtitle_margin_top">-0.4dp</dimen>

    <!--
      环形进度（framework `smartisanos.widget.CircleProgressView` /
      `CircleProgressPopup`、`res/values/dimens.xml` 与 `res/values/colors.xml`）。
    -->
    <color name="circle_progress_view_arc_color">#cccce5ff</color>
    <dimen name="circle_progress_view_size">90.0dp</dimen>

    <!--
      下拉选择（framework `smartisanos.widget.SmartisanSpinnerView`、
      `res/values/dimens.xml`）。
    -->
    <dimen name="smartisan_spinner_small_icon_width">22.0dp</dimen>
    <dimen name="smartisan_spinner_view_text_width">152.0dp</dimen>
    <dimen name="smartisan_small_blank_spacing_width">6.0dp</dimen>

    <!--
      板块分组标题的底色（framework `res/values/drawables.xml` 的
      `list_board_pressed_color` / `list_board_section_title_bg_normal`，
      被 `res/drawable/list_board_section_bg.xml` 这个 selector 引用）。
    -->
    <drawable name="list_board_pressed_color">#f2f2f2</drawable>
    <drawable name="list_board_section_title_bg_normal">#ffffffff</drawable>
</resources>
