<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:gravity="top" android:height="2.0dp">
        <shape>
            <gradient android:startColor="#0c000000" android:endColor="#00000000" android:angle="270.0" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="2.0dp">
        <shape>
            <gradient android:startColor="#0c000000" android:endColor="#00000000" android:angle="90.0" />
        </shape>
    </item>
</layer-list>
