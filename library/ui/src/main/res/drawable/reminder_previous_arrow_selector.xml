<?xml version="1.0" encoding="utf-8"?>
<!--
  日历标题栏左侧「上一个月」箭头（原版 framework res/drawable/reminder_previous_arrow_selector.xml）。

  四条 item 与原版逐字一致，包括那条「按下时画常态图」的写法：原版只有
  `state_focused="true"` 时才用 `_down` 那张，所以触摸点按时（未获得焦点）箭头不会变色。
  本库同样照抄，按下的反馈由整块按钮的缩放 / 高亮提供。
  第一条 `state_window_focused="false"` 在本库的状态集里没有对应项，永远不会命中
  （原版用它处理「窗口失焦时按常态显示」）。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_window_focused="false" android:drawable="@drawable/sos_smartisanos_drawable_remind_previous_arrow" />
    <item android:state_focused="true" android:state_pressed="true" android:drawable="@drawable/sos_smartisanos_drawable_remind_previous_arrow_down" />
    <item android:state_focused="false" android:state_pressed="true" android:drawable="@drawable/sos_smartisanos_drawable_remind_previous_arrow" />
    <item android:state_focused="true" android:drawable="@drawable/sos_smartisanos_drawable_remind_previous_arrow_down" />
</selector>
