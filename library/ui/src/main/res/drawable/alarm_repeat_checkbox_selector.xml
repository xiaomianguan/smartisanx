<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/alarm_repeat_checkbox_on_disabled"
        android:state_checked="true"
        android:state_enabled="false" />
    <item
        android:drawable="@drawable/alarm_repeat_checkbox_off_disabled"
        android:state_enabled="false" />
    <item
        android:drawable="@drawable/alarm_repeat_checkbox_on_pressed"
        android:state_checked="true"
        android:state_pressed="true" />
    <item
        android:drawable="@drawable/alarm_repeat_checkbox_on"
        android:state_checked="true" />
    <item android:drawable="@drawable/alarm_repeat_checkbox_off" />
</selector>
