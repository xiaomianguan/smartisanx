<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="0.0dp" />
            <gradient android:startColor="#33ffffff" android:endColor="#33ffffff" android:angle="270.0" android:centerY="0.75" android:centerColor="#33ffffff" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="0.0dp" />
                <gradient android:startColor="#33ffffff" android:endColor="#33ffffff" android:angle="270.0" android:centerY="0.75" android:centerColor="#33ffffff" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="0.0dp" />
                <gradient android:startColor="#3c6bcb" android:endColor="#3c6bcb" android:angle="270.0" android:centerY="0.75" android:centerColor="#3c6bcb" />
            </shape>
        </clip>
    </item>
</layer-list>
