<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/bth_bottom" />
    <item android:state_pressed="true" android:drawable="@drawable/bth_bottom" />
    <item android:state_selected="true" android:drawable="@drawable/bth_bottom" />
    <item android:state_focused="false">
        <color android:color="@android:color/transparent" />
    </item>
    <item android:state_selected="false">
        <color android:color="@android:color/transparent" />
    </item>
    <item android:state_pressed="false">
        <color android:color="@android:color/transparent" />
    </item>
</selector>
