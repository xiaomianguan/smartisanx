<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="0.0dp" />
            <gradient android:startColor="#88666666" android:endColor="#88666666" android:angle="270.0" android:centerY="0.75" android:centerColor="#88666666" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="0.0dp" />
                <gradient android:startColor="#ff005fff" android:endColor="#ff0053ff" android:angle="270.0" android:centerY="0.75" android:centerColor="#ff0052ff" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="0.0dp" />
                <gradient android:startColor="#ff0073cc" android:endColor="#ff0073cc" android:angle="270.0" android:centerY="0.75" android:centerColor="#ff0073cc" />
            </shape>
        </clip>
    </item>
</layer-list>
